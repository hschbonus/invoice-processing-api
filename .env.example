APP_ENV=development
DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoice_processing
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=INFO
PROCESSING_MODE=sync
CELERY_BROKER_URL=redis://localhost:6379/0
